    "request_seed_phrase",
    "request_private_key",
    "sign_message",
    "sign_transaction",
    "send_transaction",
    "broadcast_transaction",
    "automatic_chain_switch",
    "automatic_asset_add",
    "automatic_bridge",
    "automatic_swap"
