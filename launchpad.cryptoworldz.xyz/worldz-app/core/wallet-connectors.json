      "providerHint": "window.solana",
      "mobileHandoff": "VERIFIED_WALLET_STANDARD_OR_PROVIDER_DEEP_LINK_REQUIRED",
      "execution": false
    },
    {
      "id": "evm_eip1193",
      "family": "EVM",
      "label": "EVM Wallet",
      "standard": "EIP-1193",
      "state": "CODE_BUILT_CONNECTION_ONLY",
      "providerHint": "window.ethereum",
      "mobileHandoff": "WALLETCONNECT_V2_PAIRING_CLIENT_REQUIRED",
      "execution": false
    },
    {
      "id": "xrpl_external",
      "family": "XRPL",
      "label": "XRPL Wallet",
      "standard": "XAMAN_OAUTH_OR_VERIFIED_CONNECTION_ADAPTER",
      "state": "CONNECTION_BRIDGE_BUILT_PROVIDER_CONFIG_REQUIRED",
