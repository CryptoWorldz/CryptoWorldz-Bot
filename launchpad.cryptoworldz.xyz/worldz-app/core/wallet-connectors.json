{
  "schema": "WORLDZ-APP-WALLET-CONNECTORS-V1",
  "mode": "EXTERNAL_CUSTODY_CONNECTION_ONLY",
  "default": "DENY",
  "execution": false,
  "allowedOperations": [
    "detect_provider",
    "request_connection",
    "read_public_address",
    "read_network",
    "disconnect_local_session",
    "register_connection_only_adapter",
    "prepare_verified_mobile_handoff"
  ],
  "forbiddenOperations": [
    "request_seed_phrase",
    "request_private_key",
    "sign_message",
    "sign_transaction",
    "send_transaction",
    "broadcast_transaction",
    "automatic_chain_switch",
    "automatic_asset_add",
    "automatic_bridge",
    "automatic_swap"
  ],
  "connectors": [
