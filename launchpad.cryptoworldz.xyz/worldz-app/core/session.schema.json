{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad.cryptoworldz.xyz/worldz-app/core/session.schema.json",
  "title": "WorldzApp Public Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sessionId",
    "createdAt",
    "permissions",
    "walletConnections"
  ],
  "properties": {
    "schema": {
      "const": "WORLDZ-APP-SESSION-V1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "publicIdentity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "consentedPublicAssociation": {
          "type": "boolean"
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "uniqueItems": true
    },
    "walletConnections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain",
          "publicAddress",
          "provider",
          "connectionState"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "maxLength": 40
          },
          "publicAddress": {
            "type": "string",
            "minLength": 4,
            "maxLength": 256
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "connectionState": {
            "enum": [
              "CONNECTED",
              "DISCONNECTED",
              "READ_ONLY"
            ]
          },
          "persistedByConsent": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
