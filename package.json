{
  "name": "cryptoworldz-bot",
  "version": "3.0.0",
  "description": "Official CryptoWorldz Telegram Bot",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "check": "node --check index.js && node --check db.js && find src test public -type f -name '*.js' -exec node --check {} +",
    "check:web": "node --check apps/cryptoworldz-web-core/assets/app.js && node tools/evaluate-web-core.mjs",
    "verify:web": "npm run check:web",
    "verify": "npm run check && npm test && npm run check:web"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "node-telegram-bot-api": "1.2.0",
    "qrcode": "^1.5.4"
  }
}
