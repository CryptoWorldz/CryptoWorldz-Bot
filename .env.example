# Environment variables used by CryptoWorldz-Bot (v2 scaffold)
# Do NOT store real secrets here — this file is an example only.

# Telegram bot token (keep secret)
TELEGRAM_TOKEN=

# Supabase: project URL and anon/public key. Use service_role key only on secure server-side processes — NEVER commit it.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Database URL if you use Postgres directly
DATABASE_URL=

# Application settings
NODE_ENV=development
PORT=3000

# Optional: set to 'true' to enable debug logging
DEBUG=false
