        "signedMessageMustEqualReviewedMessage": true,
        "confirmOnChainBeforeCompleted": true,
        "autoBroadcast": false
      }
    },
    "wldzLessons": [
      "Never substitute a page deployed for wallet connected, preflight passed, owner signed or transaction confirmed.",
      "Verify a tappable production URL with no literal escape text and a working mobile connector.",
      "Quote account rent and network fees before each owner signature.",
      "Resume a Squads proposal only after proving its on-chain message matches the reviewed allocation.",
      "Keep launch, liquidity, distribution, vesting and rent recovery as separately proven states."
