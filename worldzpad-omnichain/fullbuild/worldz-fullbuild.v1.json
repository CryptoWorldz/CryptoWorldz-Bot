    "governance": {
      "brand": "WorldzGovern™",
      "purpose": "DAO proposals, treasury decisions, ecosystem rules, grants and governance execution",
      "popularityRankingEffect": false
    },
    "hardRule": "Popularity votes and governance votes must use different names, command namespaces, data stores and execution authority."
  },
