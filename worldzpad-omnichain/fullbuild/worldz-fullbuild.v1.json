    "chainCount": 8,
    "maxTokensPerChain": 20,
    "initialTokenEnvironmentCapacity": 160,
    "requiredModules": [
      "WorldzWatch™",
      "WorldzTrade™",
      "WorldzInvest™",
      "WorldzLock™",
      "WorldzVest™",
      "WorldzAlert™",
      "WorldzAuto™",
