    "defaultMainnetExecution": false,
    "externalWalletSignatureRequired": true,
    "privateKeysInTelegramDatabase": false,
    "autoBroadcastByDefault": false,
    "perChainReleaseGate": true,
    "testnetOrDevnetProofRequired": true,
    "worldzProofRequired": true,
    "explicitOwnerReleaseRequired": true
