{
  "name": "@oneworldz/command-centre",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Clean OneWorldz runtime for Zed, Grace and Auto",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "configure:telegram": "node scripts/configure-telegram.mjs",
    "check": "node --check src/*.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "dotenv": "16.6.1",
    "express": "4.22.2"
  }
}
