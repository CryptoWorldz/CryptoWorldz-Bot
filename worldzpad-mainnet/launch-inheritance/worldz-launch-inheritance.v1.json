  "identityInheritance": {
    "canonicalRegistry": "worldzpad-mainnet/token-identity/worldz-token-registry.v1.json",
    "liveTokenRequiredFields": [
      "name",
      "symbol",
      "canonicalMint",
      "decimals",
      "image",
      "website",
      "publicMetadata"
    ],
    "mintPrefixNeverUsedAsName": true,
    "unknownValuesRemainPending": true,
    "solanaLiveProviderHandoff": {
      "compiler": "scripts/build_worldz_provider_handoffs.mjs",
      "everyLiveSolanaWorldzTokenRequired": true,
      "providerGreenOnlyFromProviderData": true,
      "providers": [
        {
          "id": "jupiter-vrfd",
          "package": "worldzpad-mainnet/worlddexpush/jupiter-vrfd-worldz.v1.json"
        },
        {
          "id": "dexscreener",
          "package": "worldzpad-mainnet/worlddexpush/dexscreener-worldz.v1.json"
        }
      ]
    }
  },
  "proofInheritance": {
    "schema": "worldzpad-omnichain/schemas/worldz-proof-receipt.v1.json",
    "receiptRequiredAfterConfirmedChainAction": true,
    "passedRequiresFinalChainConfirmation": true,
    "passedRequiresBeforeAfterBalances": true,
    "passedRequiresReconciliation": true,
    "receiptMustMatchRegistryToken": true
  },
  "fullScopeInheritance": {
    "contract": "worldzpad-omnichain/fullscope/worldz-fullscope.v1.json",
    "registerEverySupportedLaunch": true,
    "actionIntentsNeverSelfBroadcast": true,
    "externalSignatureRequired": true,
    "popularityGovernanceSeparate": true
  },
