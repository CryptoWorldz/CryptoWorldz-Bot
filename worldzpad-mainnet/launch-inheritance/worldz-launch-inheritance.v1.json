    "marketDiscovery": "WorldDexPush™",
    "observability": "WorldzWatch™",
    "proof": "Worldz Proof Receipt™",
    "lifecycleReconciliation": true,
    "indexerStateNeverFaked": true,
    "vendorPaymentAutomatic": false
  },
  "executionBoundary": {
    "mainnetGlobalDefault": false,
    "perChainReleaseGate": true,
    "perVenueReleaseGate": true,
    "testnetOrDevnetProofRequired": true,
    "explicitHumanApprovalRequired": true,
    "noAutomaticVendorPayment": true,
    "noAutomaticMainnetBroadcast": true,
    "feeFlowV2MainnetRequiresRouteProof": false,
    "feeFlowV3MainnetRequiresRouteProof": true
  },
  "futureLaunchRule": "A new LIVE token cannot silently bypass inheritance or Worldz Fee Flow V3. CI must fail when canonical identity, creator-retention choice, Worldz-internal split, provider handoff where applicable, chain/environment pairing, proof schema, FullScope registration contract or public deployment package drifts."
